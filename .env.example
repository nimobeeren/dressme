# Server env vars (not exposed to the client)
# See src/server/settings.ts for documentation
MODE=development

# Auth0 (the application must be a Regular Web Application)
AUTH0_DOMAIN=auth.dressme.fashion
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_SEED_USER_ID=

# Database
DATABASE_URL=postgresql://dressme:dressme@localhost:5432/local

# AI Services
REPLICATE_API_TOKEN=
GEMINI_API_KEY=

# Blob Storage
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9100


# For local development, the app runs on http://localhost:3000.
# Make sure http://localhost:3000/auth/callback is in your Auth0 application's
# allowed callback URLs, and http://localhost:3000 is in its allowed logout URLs.
