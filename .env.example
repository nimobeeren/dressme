# API env vars (server-side, not exposed to the client)
# See src/server/settings.ts for documentation
MODE=development

# Auth0
AUTH0_ALGORITHMS=
AUTH0_API_AUDIENCE=https://dressme.local
AUTH0_DOMAIN=auth.dressme.fashion
AUTH0_ISSUER=https://auth.dressme.fashion
AUTH0_SEED_USER_ID=

# Database
DATABASE_URL=postgresql://dressme:dressme@localhost:5432/local

# AI Services
REPLICATE_API_TOKEN=
GEMINI_API_KEY=

# Blob Storage
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9100


# Client env vars (prefixed with NEXT_PUBLIC_ so they're available in the browser)
# For Next.js dev, the app runs on http://localhost:3000
# Make sure this origin is added to your Auth0 application's allowed callback URLs.

NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_AUTH0_API_AUDIENCE=https://dressme.local
NEXT_PUBLIC_AUTH0_CLIENT_ID=YfVCfpUrnAqDUmZfXg1SeGhmLHYWjQea
NEXT_PUBLIC_AUTH0_DOMAIN=auth.dressme.fashion
