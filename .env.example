# Environment variables.
# NEXT_PUBLIC_* vars are inlined into the browser bundle and exposed to the
# client; everything else stays on the server (route handlers and server code).
# See src/env/server.ts and src/env/client.ts for documentation.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SEED_USER_ID=

# Database
DATABASE_URL=postgresql://dressme:dressme@localhost:5432/local

# AI Services
REPLICATE_API_TOKEN=
GEMINI_API_KEY=

# Blob Storage
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9100

# Logging (PostHog)
# PostHog project API key (starts with `phc_`). Leave empty to disable log export.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
POSTHOG_API_HOST=https://eu.i.posthog.com
